      "target_site": "example-site-a.com",
      "lang": "en"
    },
    {
      "prompt": "how to choose <product category a>",
      "target_site": "example-site-a.com",
      "lang": "en"
    },
    {
      "prompt": "best <product category b> for <use case>",
      "target_site": "example-site-b.com",
      "lang": "en"
    },
    {
      "prompt": "<product category b> buying guide",
      "target_site": "example-site-b.com",
      "lang": "en"
    },
    {
      "prompt": "Your Brand Name review",
      "target_site": null,
      "lang": "en"
    }
  ]
