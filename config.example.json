{
  "search_backend": "brave",
  "concurrency": 4,
  "output_dir": "./reports",
  "sites": [
    {
      "domain": "example-site-a.com",
      "name": "Example Site A",
      "desc": "Knowledge site for product category A",
      "indexnow_key": "your-indexnow-key-hex-string"
    },
    {
      "domain": "example-site-b.com",
      "name": "Example Site B",
      "desc": "Knowledge site for product category B",
      "indexnow_key": "your-indexnow-key-hex-string"
    }
  ],
  "brand_terms": [
    {
      "term": "Your Brand Name",
      "desc": "brand"
    }
  ],
  "test_prompts": [
    {
      "prompt": "best <product category a> brands 2026",
